# ===== UniPulse 环境变量样例 =====
# 复制成 .env 后填写真实值；.env 已被 .gitignore 忽略，不要提交到仓库。

# 数据库文件位置（默认 data/unipulse.db，一般不修改）
UNIPULSE_DB_PATH=data/unipulse.db

# 统一时区
UNIPULSE_TIMEZONE=Asia/Shanghai

# 预览（待确认草稿）有效期，单位分钟。V4 要求过期确认必须被拒绝
UNIPULSE_PREVIEW_TTL_MINUTES=30

# 个人看板链接里 token 的有效期，单位分钟
UNIPULSE_DASHBOARD_TOKEN_TTL_MINUTES=120

# ===== 以下由成员 A 填写，B/C 开发阶段不需要真实值 =====
WECOM_BOT_ID=
WECOM_BOT_SECRET=
