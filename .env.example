# ===== UniPulse 环境变量样例 =====
# 用法：
#   cp .env.example .env      # 复制一份本地配置（.env 已被 .gitignore 忽略）
#   # 修改 .env 后，让当前终端生效：
#   set -a && source .env && set +a
#
# 注意：本项目直接读取环境变量，不会自动加载 .env 文件。
# 新开一个终端后需要重新 source 一次。

# 数据库文件位置（默认 data/unipulse.db，一般不修改）
UNIPULSE_DB_PATH=data/unipulse.db

# 统一时区（IANA 名称）。填错会直接报错，不会偷偷用默认值
UNIPULSE_TIMEZONE=Asia/Shanghai

# ===== 时间模式（services/clock.py）=====
# real = 真实时间（默认）；demo = 固定为 UNIPULSE_DEMO_NOW 指定的时刻
# 演示当天必须用 demo，否则“今天”会变成真实日期，缺口算错
UNIPULSE_TIME_MODE=real

# 仅 demo 模式使用。必须带时区偏移（+08:00），写成不带时区的形式会报错
UNIPULSE_DEMO_NOW=2026-11-30T09:00:00+08:00

# 预览（待确认草稿）有效期，单位分钟。V4 要求过期确认必须被拒绝
UNIPULSE_PREVIEW_TTL_MINUTES=30

# 个人看板链接里 token 的有效期，单位分钟
UNIPULSE_DASHBOARD_TOKEN_TTL_MINUTES=120

# ===== 认证模式（api/auth.py）=====
# demo       = 本地开发/演示，用固定的演示密钥，可以直接签发 Token
# production = 正式环境，必须提供 UNIPULSE_TOKEN_SECRET（≥32 位），否则服务启动失败
UNIPULSE_AUTH_MODE=demo

# 正式模式的 Token 签名密钥。演示模式忽略这一项。
# 生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
# 绝不能提交真实值，也不能在正式模式里用演示密钥
UNIPULSE_TOKEN_SECRET=

# ===== 以下由成员 A 填写，B/C 开发阶段不需要真实值 =====
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# LLM 服务（A 的 Agent 用）。注意：不同厂商的变量名可能不同，以 A 实际使用的 SDK 为准
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
